CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_SPI_FLASH_DANGEROUS_WRITE_ALLOWED=y
CONFIG_APP_PROJECT_VER_FROM_CONFIG=n
# web server
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_LWIP_MAX_SOCKETS=20
# TLS client for downloads from Shelly's update server
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_TLS_INSECURE=n
# memory
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
# logging: keep it short, no assertion strings
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# littlefs (read-only import of the Shelly configuration)
CONFIG_LITTLEFS_MAX_PARTITIONS=2
# wolfSSH
CONFIG_ESP_ENABLE_WOLFSSH=y
CONFIG_ESP_WOLFSSL_ENABLE_MY_USE_RSA=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
# Bluetooth not used
CONFIG_BT_ENABLED=n
# a hung task must not leave the console server unreachable: watchdog -> panic -> reboot
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y
# TLS memory: buffers allocated per record instead of 2x16 KB per connection
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
